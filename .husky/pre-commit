#!/usr/bin/env sh

# Block committing any .env file that is not a .env.example or .env.*.example
# Only checks added/copied/modified files — not deletions
STAGED=$(git diff --cached --name-only --diff-filter=ACM)

ENV_FILES=$(echo "$STAGED" | grep -E '(^|/)\.env(\.[^/]+)?$' | grep -v '\.example$' || true)

if [ -n "$ENV_FILES" ]; then
  echo ""
  echo "  husky - BLOCKED: Attempt to commit .env file(s) with potential secrets:"
  echo ""
  echo "$ENV_FILES" | sed 's/^/    /'
  echo ""
  echo "  Add these files to .gitignore or rename to .env.example"
  echo ""
  exit 1
fi

# Run lint-staged to check code quality
npx lint-staged

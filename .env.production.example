# ═══════════════════════════════════════════════════════════════
#  Production Environment Variables Reference
#  This file documents all variables needed for Azure deployment.
#  DO NOT commit real secrets — use GitHub Secrets instead.
# ═══════════════════════════════════════════════════════════════

# ─── PostgreSQL (Azure Database for PostgreSQL Flexible Server) ───
DATABASE_URL=postgresql://pgadmin:<PASSWORD>@retro-tool-production-pg.postgres.database.azure.com:5432/api_db?sslmode=require
POSTGRES_ADMIN_USERNAME=pgadmin
POSTGRES_ADMIN_PASSWORD=<generate: openssl rand -base64 32>

# ─── API (Azure App Service) ─────────────────────────────────────
NODE_ENV=production
PORT=8000
BETTER_AUTH_SECRET=<generate: openssl rand -base64 32>
BETTER_AUTH_URL=https://retro-tool-production-api.azurewebsites.net
BETTER_AUTH_SESSION_EXPIRES_IN=604800
FRONTEND_URL=https://<SWA-hostname>.azurestaticapps.net
ALLOWED_ORIGINS=https://<SWA-hostname>.azurestaticapps.net
LOCAL_SERVER_URL=https://retro-tool-production-api.azurewebsites.net
DEPLOYED_SERVER_URL=https://retro-tool-production-api.azurewebsites.net

# ─── OAuth ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
MICROSOFT_CLIENT_ID=<from Azure App Registration>
MICROSOFT_CLIENT_SECRET=<from Azure App Registration>

# ─── Email (Resend) ──────────────────────────────────────────────
RESEND_API_KEY=<from https://resend.com>

# ─── Redis (optional — leave empty if not using) ─────────────────
REDIS_URL=

# ─── Push Notifications (VAPID) ──────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<generated>
VAPID_PRIVATE_KEY=<generated>
VAPID_SUBJECT=mailto:you@yourdomain.com

# ─── Cron / Scheduled Tasks ────────────────────────────────────
ENABLE_CRON_JOBS=true
WEEKLY_DIGEST_SEND_HOUR=6

# ─── Convex (Azure Container Instance) ───────────────────────────
CONVEX_INSTANCE_NAME=retro-convex-production
CONVEX_INSTANCE_SECRET=<generate: openssl rand -hex 32>
CONVEX_POSTGRES_URL=postgresql://pgadmin:<PASSWORD>@retro-tool-production-pg.postgres.database.azure.com:5432?sslmode=require
CONVEX_SYNC_URL=http://retro-tool-production-convex.<region>.azurecontainer.io:3210
CONVEX_SYNC_ADMIN_KEY=<generated from running Convex backend>
CONVEX_DEPLOY_KEY=<generated from running Convex backend>

# ─── UI (Azure Static Web App) ───────────────────────────────────
VITE_APP_ENV=production
VITE_API_URL=https://retro-tool-production-api.azurewebsites.net
VITE_APP_TITLE=Retro Tool
VITE_CONVEX_URL=http://retro-tool-production-convex.<region>.azurecontainer.io:3210
VITE_ESTIMATES_REALTIME_BACKEND=convex
VITE_RETROS_REALTIME_BACKEND=convex
VITE_NOTIFICATIONS_REALTIME_BACKEND=convex

# ─── Azure Static Web App Deployment ─────────────────────────────
SWA_DEPLOYMENT_TOKEN=<from Azure Portal or Bicep output>

# ═══════════════════════════════════════════════════════════════
#  Production Environment Variables Reference
#  This file documents all variables needed for Azure deployment.
#  DO NOT commit real secrets — use GitHub Secrets instead.
#  See DEPLOYMENT.md for where each value comes from.
# ═══════════════════════════════════════════════════════════════

# ─── PostgreSQL ───────────────────────────────────────────────
# GitHub Secret: DATABASE_URL
DATABASE_URL=postgresql://pgadmin:<POSTGRES_PASSWORD>@retro-tool-production-pg.postgres.database.azure.com:5432/retro_tool_db?sslmode=require
# GitHub Secrets: used by Bicep to create the PostgreSQL server
POSTGRES_USER=pgadmin
POSTGRES_PASSWORD=<generate: openssl rand -base64 32>

# ─── API (Azure App Service) ──────────────────────────────────
# All set as App Service env vars by deploy-api.yml
NODE_ENV=production
PORT=8000
BETTER_AUTH_SECRET=<generate: openssl rand -base64 32>
BETTER_AUTH_URL=https://retro-tool-production-api.azurewebsites.net
BETTER_AUTH_SESSION_EXPIRES_IN=604800
FRONTEND_URL=https://victorious-coast-026649b03.2.azurestaticapps.net
ALLOWED_ORIGINS=https://victorious-coast-026649b03.2.azurestaticapps.net
LOCAL_SERVER_URL=https://retro-tool-production-api.azurewebsites.net
DEPLOYED_SERVER_URL=https://retro-tool-production-api.azurewebsites.net

# ─── OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>
MICROSOFT_CLIENT_ID=<from Azure App Registration>
MICROSOFT_CLIENT_SECRET=<from Azure App Registration>
MICROSOFT_TENANT_ID=common

# ─── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=<from https://resend.com>
EMAIL_FROM=Retro Tool <noreply@yourdomain.com>

# ─── Redis (optional) ─────────────────────────────────────────
REDIS_URL=

# ─── Push Notifications (VAPID) ───────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=<generated>
VAPID_PRIVATE_KEY=<generated>
VAPID_SUBJECT=mailto:you@yourdomain.com

# ─── Cron / Scheduled Tasks ───────────────────────────────────
ENABLE_CRON_JOBS=true
WEEKLY_DIGEST_SEND_HOUR=6

# ─── Convex (Azure Container Instance) ────────────────────────
# INSTANCE_NAME, INSTANCE_SECRET, POSTGRES_URL → Bicep only, never set manually
# DISABLE_BEACON=1 → hardcoded in container-instance.bicep

# GitHub Variable (from Bicep output convexSyncUrl):
CONVEX_SYNC_URL=http://retro-tool-production-convex.southafricanorth.azurecontainer.io:3210

# GitHub Secret — used by API (app settings) and deploy-convex.yml:
# Generate: docker run --rm -e INSTANCE_NAME=retro-convex-production -e INSTANCE_SECRET=<secret> --entrypoint="" ghcr.io/get-convex/convex-backend:latest ./generate_admin_key.sh
CONVEX_SYNC_ADMIN_KEY=<retro-convex-production|hex>

# ─── UI (Azure Static Web App) ────────────────────────────────
# Set as build args in deploy-ui.yml — not App Service env vars
VITE_APP_ENV=production
VITE_API_URL=https://retro-tool-production-api.azurewebsites.net
VITE_APP_TITLE=Retro Tool
VITE_CONVEX_URL=http://retro-tool-production-convex.southafricanorth.azurecontainer.io:3210
VITE_ESTIMATES_REALTIME_BACKEND=convex
VITE_RETROS_REALTIME_BACKEND=convex
VITE_NOTIFICATIONS_REALTIME_BACKEND=convex

# ─── Azure Deployment ─────────────────────────────────────────
# GitHub Secret — fetch after Bicep deploy:
# az staticwebapp secrets list --resource-group retro-tool-ui-rg --name retro-tool-production-ui --query 'properties.apiKey' -o tsv
SWA_DEPLOYMENT_TOKEN=<from az staticwebapp secrets list>

# GitHub Secrets — OIDC auth for GitHub Actions:
AZURE_CLIENT_ID=1ba4d186-d1f5-438a-af76-c4bd48cb1b6f
AZURE_TENANT_ID=8836f453-4545-4de7-b26d-07b7feb10a38
AZURE_SUBSCRIPTION_ID=7923d1d5-ae98-4134-b678-c4b002a1258b

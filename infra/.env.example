# Infra deployment environment variables for this repository.
# Copy to infra/.env and fill in real values before deploying.

# Azure context (OIDC / CLI)
AZURE_SUBSCRIPTION_ID=<subscription-guid>
AZURE_TENANT_ID=<tenant-guid>
AZURE_CLIENT_ID=<app-registration-client-id>

# Deployment target
ENVIRONMENT_NAME=production
AZURE_DEPLOYMENT_LOCATION=southafricanorth
AZURE_LOCATION_CORE=southafricanorth
AZURE_LOCATION_SWA=westeurope
AZURE_RESOURCE_GROUP_API=retro-tool-api-rg
AZURE_RESOURCE_GROUP_UI=retro-tool-ui-rg

# Bicep non-secret parameters
POSTGRES_ADMIN_USERNAME=pgadmin
CONVEX_INSTANCE_NAME=convex-local
CONVEX_ACI_IP=<aci-public-ip-or-empty>

# Caddy / HTTPS settings
CADDY_ACME_EMAIL=ops@yourdomain.com
CADDY_PERSIST_CERTIFICATES=true
CADDY_CERT_STORAGE_ACCOUNT_NAME=retrotoolcaddycerts
CADDY_CERT_STORAGE_SHARE_NAME=caddy-data

# Secrets (do not commit real values)
POSTGRES_ADMIN_PASSWORD=<strong-password>
CONVEX_INSTANCE_SECRET=<64-char-hex-from-openssl-rand-hex-32>
CADDY_CERT_STORAGE_ACCOUNT_KEY=<storage-account-key-or-empty-if-disabled>

# Example deploy command using this file (PowerShell):
# Set-Location d:\projects\Retro Project\Retro-Tool
# Get-Content infra/.env | ForEach-Object {
#   if ($_ -match '^(\w+)=(.*)$') { [Environment]::SetEnvironmentVariable($matches[1], $matches[2], 'Process') }
# }
# az deployment sub create \
#   --name main \
#   --location $env:AZURE_DEPLOYMENT_LOCATION \
#   --template-file infra/bicep/main.bicep \
#   --parameters \
#     environmentName=$env:ENVIRONMENT_NAME \
#     apiResourceGroupName=$env:AZURE_RESOURCE_GROUP_API \
#     uiResourceGroupName=$env:AZURE_RESOURCE_GROUP_UI \
#     locationCore=$env:AZURE_LOCATION_CORE \
#     locationSwa=$env:AZURE_LOCATION_SWA \
#     postgresAdminUsername=$env:POSTGRES_ADMIN_USERNAME \
#     postgresAdminPassword=$env:POSTGRES_ADMIN_PASSWORD \
#     convexInstanceName=$env:CONVEX_INSTANCE_NAME \
#     convexInstanceSecret=$env:CONVEX_INSTANCE_SECRET \
#     convexAciIp=$env:CONVEX_ACI_IP \
#     caddyAcmeEmail=$env:CADDY_ACME_EMAIL \
#     caddyPersistCertificates=$env:CADDY_PERSIST_CERTIFICATES \
#     caddyCertStorageAccountName=$env:CADDY_CERT_STORAGE_ACCOUNT_NAME \
#     caddyCertStorageShareName=$env:CADDY_CERT_STORAGE_SHARE_NAME \
#     caddyCertStorageAccountKey=$env:CADDY_CERT_STORAGE_ACCOUNT_KEY

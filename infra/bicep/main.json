                    "server": "[parameters('acrLoginServer')]",
                    "username": "[parameters('acrUsername')]",
                    "password": "[parameters('acrPassword')]"
                  }
                ],
                "containers": [
                  {
                    "name": "convex-backend",
                    "properties": {
                      "image": "[format('ghcr.io/get-convex/convex-backend:{0}', parameters('convexImageTag'))]",

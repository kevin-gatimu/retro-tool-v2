              "type": "string",
              "value": "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('postgresqlServerName'))]"
            },
            "postgresqlServerName": {
              "type": "string",
              "value": "[parameters('postgresqlServerName')]"
            },
            "postgresqlServerFqdn": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', parameters('postgresqlServerName')), '2023-12-01-preview').fullyQualifiedDomainName]"

    "convex": {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "deploy-convex-aci",
      "resourceGroup": "[parameters('apiResourceGroupName')]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "location": {
            "value": "[parameters('locationCore')]"
          },
          "containerGroupName": {
            "value": "[variables('containerGroupName')]"
          },
          "acrLoginServer": {
            "value": "[reference('acr').outputs.acrLoginServer.value]"
          },
          "acrUsername": {
            "value": "[variables('acrName')]"
          },
          "acrPassword": {
            "value": "[listCredentials('acrRef', '2023-07-01').passwords[0].value]"
          },
          "convexInstanceName": {
            "value": "[parameters('convexInstanceName')]"
          },
          "convexInstanceSecret": {
            "value": "[parameters('convexInstanceSecret')]"
          },
          "convexPostgresUrl": {
            "value": "[format('postgresql://{0}:{1}@{2}:5432?sslmode=require', parameters('postgresAdminUsername'), parameters('postgresAdminPassword'), reference('postgres').outputs.postgresqlServerFqdn.value)]"
          },
          "caddyAcmeEmail": {
            "value": "[parameters('caddyAcmeEmail')]"
          },
          "caddyPersistCertificates": {
            "value": "[parameters('caddyPersistCertificates')]"
          },
          "caddyCertStorageAccountName": {
            "value": "[parameters('caddyCertStorageAccountName')]"
          },
          "caddyCertStorageShareName": {

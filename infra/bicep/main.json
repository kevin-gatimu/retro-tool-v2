              "type": "string"
            },
            "containerGroupName": {
              "type": "string"
            },
            "acrLoginServer": {
              "type": "string"
            },
            "acrUsername": {
              "type": "string"
            },
            "acrPassword": {
              "type": "securestring"
            },
            "convexImageTag": {
              "type": "string",
              "defaultValue": "latest"
            },
            "convexInstanceName": {
              "type": "string"
            },
            "convexInstanceSecret": {
              "type": "securestring"
            },
            "convexPostgresUrl": {
              "type": "securestring"
            },
            "cpuCores": {
              "type": "int",
              "defaultValue": 1
            },
            "memoryGB": {
              "type": "int",
              "defaultValue": 2
            },
            "caddyAcmeEmail": {
              "type": "string"
            },
            "caddyPersistCertificates": {
              "type": "bool",
              "defaultValue": false
            },
            "caddyCertStorageAccountName": {
              "type": "string",
              "defaultValue": ""
            },
            "caddyCertStorageAccountKey": {
              "type": "securestring",
              "defaultValue": ""
            },
            "caddyCertStorageShareName": {
              "type": "string",
              "defaultValue": ""
            },
            "tags": {
              "type": "object",
              "defaultValue": {}

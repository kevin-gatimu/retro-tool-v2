            "storageGB": {
              "type": "int",
              "defaultValue": 32
            },
            "backupRetentionDays": {
              "type": "int",
              "defaultValue": 7
            },
            "geoRedundantBackup": {
              "type": "string",
              "defaultValue": "Disabled"

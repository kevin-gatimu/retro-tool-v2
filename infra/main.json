{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "9546675503070487713"
    }
  },
  "parameters": {
    "environment": {
      "type": "string",
      "metadata": {
        "description": "Environment name (e.g. prod, staging)"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "southafricanorth",
      "metadata": {
        "description": "Primary Azure region for most resources"
      }
    },
    "staticWebAppLocation": {
      "type": "string",
      "defaultValue": "westeurope",
      "metadata": {
        "description": "Region for Static Web App (not available in South Africa North)"
      }
    },
    "postgresAdminLogin": {
      "type": "string",
      "defaultValue": "pgadmin",
      "metadata": {
        "description": "PostgreSQL administrator login"
      }
    },
    "postgresAdminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "PostgreSQL administrator password"
      }
    },
    "dockerImageName": {
      "type": "string",
      "defaultValue": "retro-tool-api",
      "metadata": {
        "description": "Docker image name"
      }
    },
    "dockerImageTag": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Docker image tag"
      }
    },
    "apiAppSettings": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Application settings for the API App Service"
      }
    }
  },
  "variables": {
    "copy": [
      {
        "name": "customAppSettings",
        "count": "[length(items(parameters('apiAppSettings')))]",
        "input": {
          "name": "[items(parameters('apiAppSettings'))[copyIndex('customAppSettings')].key]",
          "value": "[items(parameters('apiAppSettings'))[copyIndex('customAppSettings')].value]"
        }
      }
    ],
    "prefix": "[format('retrotool-{0}', parameters('environment'))]",
    "acrName": "[replace(format('{0}acr', variables('prefix')), '-', '')]",
    "tags": {
      "environment": "[parameters('environment')]",
      "project": "retro-tool",
      "managedBy": "bicep"
    },
    "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d"
  },
  "resources": [
    {
      "type": "Microsoft.ContainerRegistry/registries",
      "apiVersion": "2023-07-01",
      "name": "[variables('acrName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard"
      },
      "properties": {
        "adminUserEnabled": false,
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('{0}-identity', variables('prefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]"
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
      "name": "[guid(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', variables('prefix'))), variables('acrPullRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', variables('prefix'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPullRoleId'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('{0}-db', variables('prefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard_B1ms",
        "tier": "Burstable"
      },
      "properties": {
        "version": "17",
        "administratorLogin": "[parameters('postgresAdminLogin')]",
        "administratorLoginPassword": "[parameters('postgresAdminPassword')]",
        "storage": {
          "storageSizeGB": 32,
          "autoGrow": "Enabled",
          "tier": "P4"
        },
        "backup": {
          "backupRetentionDays": 7,
          "geoRedundantBackup": "Disabled"
        },
        "highAvailability": {
          "mode": "Disabled"
        },
        "network": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/firewallRules",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('{0}/{1}', format('{0}-db', variables('prefix')), 'AllowAzureServices')]",
      "properties": {
        "startIpAddress": "0.0.0.0",
        "endIpAddress": "0.0.0.0"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.DBforPostgreSQL/flexibleServers/databases",
      "apiVersion": "2023-12-01-preview",
      "name": "[format('{0}/{1}', format('{0}-db', variables('prefix')), 'retro_tool_db')]",
      "properties": {
        "charset": "UTF8",
        "collation": "en_US.utf8"
      },
      "dependsOn": [
        "[resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-plan', variables('prefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "linux",
      "sku": {
        "name": "P0v3",
        "tier": "PremiumV3"
      },
      "properties": {
        "reserved": true,
        "zoneRedundant": false
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-api', variables('prefix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('tags')]",
      "kind": "app,linux,container",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', variables('prefix'))))]": {}
        }
      },
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', variables('prefix')))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "[format('DOCKER|{0}/{1}:{2}', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer, parameters('dockerImageName'), parameters('dockerImageTag'))]",
          "acrUseManagedIdentityCreds": true,
          "acrUserManagedIdentityID": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', variables('prefix'))), '2023-01-31').clientId]",
          "alwaysOn": true,
          "http20Enabled": true,
          "webSocketsEnabled": true,
          "minTlsVersion": "1.2",
          "ftpsState": "Disabled",
          "appSettings": "[concat(createArray(createObject('name', 'DOCKER_REGISTRY_SERVER_URL', 'value', format('https://{0}', reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer)), createObject('name', 'WEBSITES_ENABLE_APP_SERVICE_STORAGE', 'value', 'false')), variables('customAppSettings'))]"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ContainerRegistry/registries', variables('acrName'))]",
        "[resourceId('Microsoft.Web/serverfarms', format('{0}-plan', variables('prefix')))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', variables('prefix')))]"
      ]
    },
    {
      "type": "Microsoft.Web/staticSites",
      "apiVersion": "2023-12-01",
      "name": "[format('{0}-ui', variables('prefix'))]",
      "location": "[parameters('staticWebAppLocation')]",
      "tags": "[variables('tags')]",
      "sku": {
        "name": "Standard",
        "tier": "Standard"
      },
      "properties": {
        "stagingEnvironmentPolicy": "Enabled",
        "allowConfigFileUpdates": true
      }
    }
  ],
  "outputs": {
    "acrLoginServer": {
      "type": "string",
      "metadata": {
        "description": "ACR login server — use in GitHub Actions to push images"
      },
      "value": "[reference(resourceId('Microsoft.ContainerRegistry/registries', variables('acrName')), '2023-07-01').loginServer]"
    },
    "acrName": {
      "type": "string",
      "metadata": {
        "description": "ACR name — needed for `az acr login` and role assignments"
      },
      "value": "[variables('acrName')]"
    },
    "staticWebAppName": {
      "type": "string",
      "metadata": {
        "description": "Static Web App name — use to retrieve deployment token: az staticwebapp secrets list --name <this>"
      },
      "value": "[format('{0}-ui', variables('prefix'))]"
    },
    "apiUrl": {
      "type": "string",
      "metadata": {
        "description": "API URL — use as BETTER_AUTH_URL and for CORS"
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/sites', format('{0}-api', variables('prefix'))), '2023-12-01').defaultHostName)]"
    },
    "uiUrl": {
      "type": "string",
      "metadata": {
        "description": "UI URL — use as FRONTEND_URL in API env vars"
      },
      "value": "[format('https://{0}', reference(resourceId('Microsoft.Web/staticSites', format('{0}-ui', variables('prefix'))), '2023-12-01').defaultHostname)]"
    },
    "databaseUrl": {
      "type": "string",
      "metadata": {
        "description": "DATABASE_URL template — replace <password> with the actual admin password"
      },
      "value": "[format('postgresql://{0}:<password>@{1}:5432/retro_tool_db?sslmode=require', parameters('postgresAdminLogin'), reference(resourceId('Microsoft.DBforPostgreSQL/flexibleServers', format('{0}-db', variables('prefix'))), '2023-12-01-preview').fullyQualifiedDomainName)]"
    },
    "managedIdentityClientId": {
      "type": "string",
      "metadata": {
        "description": "Managed Identity Client ID (already configured on App Service)"
      },
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('{0}-identity', variables('prefix'))), '2023-01-31').clientId]"
    },
    "appServiceName": {
      "type": "string",
      "metadata": {
        "description": "App Service name — needed for `az webapp deploy` or restart commands"
      },
      "value": "[format('{0}-api', variables('prefix'))]"
    }
  }
}
# ── Convex CLI / Browser Connection ──────────────────────────────────────────
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# Generated from the running local Convex backend: ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-admin-key-from-generate_admin_key.sh

# ── Convex Cloud (leave empty if using self-hosted) ───────────────────────────
CONVEX_CLOUD_URL=
CONVEX_DEPLOYMENT=

# ── Convex Backend Runtime ────────────────────────────────────────────────────
CONVEX_INSTANCE_NAME=convex-local
# Generate: openssl rand -hex 32
CONVEX_INSTANCE_SECRET=replace-with-64-char-hex-secret
CONVEX_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432
CONVEX_DO_NOT_REQUIRE_SSL=1

# ── API Auth Integration ──────────────────────────────────────────────────────
CONVEX_BETTER_AUTH_URL=http://localhost:8000/api/auth

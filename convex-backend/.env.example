# ── Convex CLI / Browser Connection ──────────────────────────────────────────
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
# Generated from the running local Convex backend: ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-admin-key-from-generate_admin_key.sh

# ── Convex Cloud (leave empty if using self-hosted) ───────────────────────────
CONVEX_CLOUD_URL=
CONVEX_DEPLOYMENT=

# ── Convex Backend Runtime ────────────────────────────────────────────────────
CONVEX_INSTANCE_NAME=convex-local
# Generate: openssl rand -hex 32
CONVEX_INSTANCE_SECRET=replace-with-64-char-hex-secret
CONVEX_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432
CONVEX_DO_NOT_REQUIRE_SSL=1

# ── API Auth Integration ──────────────────────────────────────────────────────
CONVEX_BETTER_AUTH_URL=http://localhost:8000/api/auth

# ── JWT verification (set ON THE CONVEX DEPLOYMENT, not loaded from this file) ──
# convex/auth.config.ts reads these via process.env INSIDE Convex functions, so
# they live in the Convex deployment's environment — NOT in this .env file (which
# only configures the Convex CLI/container). Set them against the running
# self-hosted backend with the CLI:
#
#   pnpm --filter convex-backend exec convex env set JWT_ISSUER   http://localhost:8000
#   pnpm --filter convex-backend exec convex env set JWT_AUDIENCE convex
#   pnpm --filter convex-backend exec convex env set JWT_JWKS_URL http://host.docker.internal:8000/api/auth/jwks
#
# (the CLI targets the deployment via CONVEX_SELF_HOSTED_URL + _ADMIN_KEY above)
#
#   JWT_ISSUER   — must equal the API's emitted token `iss` byte-for-byte
#                  (= the API's BETTER_AUTH_URL, e.g. http://localhost:8000). This
#                  is an identity STRING MATCH, never fetched over the network.
#   JWT_AUDIENCE — must equal the API's BETTER_AUTH_JWT_AUDIENCE (default 'convex').
#   JWT_JWKS_URL — the API's JWKS endpoint, which the Convex backend FETCHES over
#                  the network. The container's `localhost` is the container
#                  itself, so a host-machine API is NOT reachable as
#                  http://localhost:8000 — use http://host.docker.internal:8000/api/auth/jwks
#                  (Docker Desktop), or the compose service name when the API runs
#                  in the same network: http://nest-api:8000/api/auth/jwks.

# ── Local Convex CLI pointing at SELF-HOSTED Docker backend ──────────────────
# Run with: pnpm dev (or pnpm local:up for the full Docker stack)
#
# Local dev runs the SELF-HOSTED Convex container, so the "SELF-HOSTED" block
# below is the ACTIVE one. The "CONVEX CLOUD" block is inactive here and kept
# only for parity/reference with the staging/prod env files.

# =============================================================================
# CONVEX CLOUD   ← INACTIVE locally (leave empty when self-hosting)
# =============================================================================
# CONVEX_DEPLOY_KEY — Convex CLI auth to DEPLOY functions to Convex Cloud.
#   NOT the same as the API's CONVEX_SYNC_ADMIN_KEY (that's runtime data sync).
#   Get from: dashboard.convex.dev → your deployment → Settings → Deploy Key
CONVEX_DEPLOY_KEY=
# CONVEX_DEPLOYMENT — which Cloud deployment `convex dev`/`deploy` targets.
# This is the deployment NAME only (<type>:<name>) — the token belongs in
# CONVEX_DEPLOY_KEY above, not here.
CONVEX_DEPLOYMENT=
# CONVEX_CLOUD_URL — the deployment's Cloud URL (https://<name>.<region>.convex.cloud).
CONVEX_CLOUD_URL=

# =============================================================================
# SELF-HOSTED    ← ACTIVE for local dev
# =============================================================================
# CLI targeting of the local self-hosted backend. ADMIN_KEY comes from the
# running container: ./generate_admin_key.sh (or the local dashboard :6791).
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-admin-key-from-generate_admin_key.sh
# Convex container runtime. INSTANCE_NAME derives the Postgres DB name
# (hyphens → underscores → `convex_local`); SECRET is `openssl rand -hex 32`.
CONVEX_INSTANCE_NAME=convex-local
CONVEX_INSTANCE_SECRET=replace-with-64-char-hex-secret
CONVEX_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432
CONVEX_DO_NOT_REQUIRE_SSL=1

# =============================================================================
# SHARED — API auth integration (applies regardless of Cloud vs self-hosted)
# =============================================================================
CONVEX_BETTER_AUTH_URL=http://localhost:8000/api/auth

# ── JWT verification (set ON THE LOCAL CONVEX DEPLOYMENT via the CLI) ────────
# auth.config.ts reads these via process.env inside Convex functions, so set them
# on the deployment — NOT here (this file only configures the CLI/container).
# Target the self-hosted backend via CONVEX_SELF_HOSTED_URL + _ADMIN_KEY above:
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=convex
JWT_JWKS_URL=http://host.docker.internal:8000/api/auth/jwks

# ── NOTE on JWT_JWKS_URL ──────────────────────────────────────────────────────
# The self-hosted Convex container fetches JWKS over the network. `localhost`
# inside the container is itself — not the host machine. Use:
#   • http://host.docker.internal:8000/api/auth/jwks  (Docker Desktop)
#   • http://<compose-service-name>:8000/api/auth/jwks  (same Docker network)
# Verify deployed values: `convex env list`

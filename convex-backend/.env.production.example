# ── Convex CLI / Browser Connection ──────────────────────────────────────────
CONVEX_SELF_HOSTED_URL=https://convex-api.yourdomain.com
# Generated from the running Convex backend: ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-production-admin-key

# ── Convex Cloud (leave empty if using self-hosted) ───────────────────────────
CONVEX_CLOUD_URL=
CONVEX_DEPLOYMENT=

# ── Convex Backend Runtime ────────────────────────────────────────────────────
CONVEX_INSTANCE_NAME=retro-convex-production
# Generate: openssl rand -hex 32
CONVEX_INSTANCE_SECRET=replace-with-64-char-hex-secret
CONVEX_POSTGRES_URL=postgresql://pgadmin:replace-with-password@your-db-host:5432?sslmode=require
CONVEX_DO_NOT_REQUIRE_SSL=0

# ── API Auth Integration ──────────────────────────────────────────────────────
CONVEX_BETTER_AUTH_URL=https://api.yourdomain.com/api/auth

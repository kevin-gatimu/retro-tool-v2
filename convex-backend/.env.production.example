# ── Convex CLI / Browser Connection ──────────────────────────────────────────
CONVEX_SELF_HOSTED_URL=https://convex-api.yourdomain.com
# Generated from the running Convex backend: ./generate_admin_key.sh
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-production-admin-key

# ── Convex Cloud (leave empty if using self-hosted) ───────────────────────────
CONVEX_CLOUD_URL=
CONVEX_DEPLOYMENT=

# ── Convex Backend Runtime ────────────────────────────────────────────────────
CONVEX_INSTANCE_NAME=retro-convex-production
# Generate: openssl rand -hex 32
CONVEX_INSTANCE_SECRET=replace-with-64-char-hex-secret
CONVEX_POSTGRES_URL=postgresql://pgadmin:replace-with-password@your-db-host:5432?sslmode=require
CONVEX_DO_NOT_REQUIRE_SSL=0

# ── API Auth Integration ──────────────────────────────────────────────────────
CONVEX_BETTER_AUTH_URL=https://api.yourdomain.com/api/auth

# ── JWT verification (set ON THE CONVEX DEPLOYMENT, not loaded from this file) ──
# convex/auth.config.ts reads these via process.env INSIDE Convex functions, so
# they live in the Convex deployment's environment, set per-deployment via the
# CLI or dashboard — NOT in this .env file. For each environment:
#
#   convex env set JWT_ISSUER   https://<deployed-api-host>          # e.g. https://retrotool-prod-api.azurewebsites.net
#   convex env set JWT_AUDIENCE convex
#   convex env set JWT_JWKS_URL https://<deployed-api-host>/api/auth/jwks
#
# (Convex Cloud: `npx convex env set …` with CONVEX_DEPLOY_KEY set, or the
#  dashboard → Deployment Settings → Environment Variables. Self-hosted: point
#  the CLI at CONVEX_SELF_HOSTED_URL + _ADMIN_KEY.)
#
#   JWT_ISSUER   — must equal the deployed API's token `iss` BYTE-FOR-BYTE (= its
#                  BETTER_AUTH_URL; on Azure this is https://{API_WEBAPP_NAME}.azurewebsites.net,
#                  computed by deploy-api.yml). A trailing-slash / scheme / port
#                  mismatch breaks verification. Identity string match, not fetched.
#   JWT_AUDIENCE — must equal the API's BETTER_AUTH_JWT_AUDIENCE (default 'convex').
#   JWT_JWKS_URL — `${JWT_ISSUER}/api/auth/jwks`; must be PUBLICLY reachable from
#                  the Convex deployment (Convex Cloud fetches it over the internet).

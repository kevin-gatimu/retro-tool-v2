# Convex Self-Hosted Configuration
CONVEX_SELF_HOSTED_URL=https://convex-api.example.com
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-production-admin-key

# Convex Cloud (leave empty if using self-hosted)
CONVEX_CLOUD_URL=
CONVEX_DEPLOYMENT=

# Convex backend runtime environment variables
CONVEX_INSTANCE_NAME=retro-convex-production
CONVEX_INSTANCE_SECRET=<generate: openssl rand -hex 32>
CONVEX_POSTGRES_URL=postgresql://pgadmin:<PASSWORD>@retro-tool-production-pg.postgres.database.azure.com:5432?sslmode=require
CONVEX_DO_NOT_REQUIRE_SSL=0

# Backend API auth integration
CONVEX_BETTER_AUTH_URL=https://retro-tool-production-api.azurewebsites.net/api/auth
# ── Local Convex CLI pointing at PRODUCTION (Convex Cloud) ───────────────────
# Run with: pnpm dev:prod
#
# This deployment runs on CONVEX CLOUD, so the "CONVEX CLOUD" block below is the
# ACTIVE one. The "SELF-HOSTED" block is inactive here — Convex Cloud manages the
# backend and its Postgres for you — and is kept only for parity/reference.

# =============================================================================
# CONVEX CLOUD   ← ACTIVE for this file
# =============================================================================
# CONVEX_DEPLOY_KEY — Convex CLI auth to DEPLOY functions to Convex Cloud.
#   NOT the same as the API's CONVEX_SYNC_ADMIN_KEY (that's runtime data sync).
#   Get from: dashboard.convex.dev → your deployment → Settings → Deploy Key
CONVEX_DEPLOY_KEY=prod:replace-with-deployment-name|replace-with-deploy-key-token
# CONVEX_DEPLOYMENT — which Cloud deployment `convex dev`/`deploy` targets.
# This is the deployment NAME only (<type>:<name>) — the token belongs in
# CONVEX_DEPLOY_KEY above, not here.
CONVEX_DEPLOYMENT=prod:replace-with-deployment-name
# CONVEX_CLOUD_URL — the deployment's Cloud URL (https://<name>.convex.cloud).
CONVEX_CLOUD_URL=https://replace-with-deployment-name.convex.cloud
# ── API Auth Integration (deployed API) ──────────────────────────────────────
CONVEX_BETTER_AUTH_URL=https://replace-with-api-hostname/api/auth

# ── JWT verification (set ON THE PRODUCTION CONVEX DEPLOYMENT via the CLI) ───
# auth.config.ts reads these via process.env inside Convex functions, so set them
# on the deployment — NOT here (this file only configures the CLI). With this
# file loaded (pnpm --filter convex-backend dev:prod targets the production
# deployment via CONVEX_DEPLOY_KEY above):
JWT_ISSUER=https://replace-with-api-hostname
JWT_AUDIENCE=convex
JWT_JWKS_URL=https://replace-with-api-hostname/api/auth/jwks

# =============================================================================
# SELF-HOSTED    ← INACTIVE on Cloud (leave empty when using Convex Cloud)
# =============================================================================
# CLI targeting of a self-hosted backend (empty → CLI uses the Cloud block above):
# CONVEX_SELF_HOSTED_URL=
# CONVEX_SELF_HOSTED_ADMIN_KEY=
# Convex container runtime. Ignored on Cloud — placeholders only. Fill these in
# only if you self-host. INSTANCE_NAME derives the self-hosted Postgres DB name
# (hyphens → underscores); SECRET is `openssl rand -hex 32`.
# CONVEX_INSTANCE_NAME=<self-hosted-instance-name>
# CONVEX_INSTANCE_SECRET=<64-char-hex-secret>
# CONVEX_POSTGRES_URL=<self-hosted-postgres-url>
# CONVEX_DO_NOT_REQUIRE_SSL=0
# CONVEX_BETTER_AUTH_URL=https://replace-with-api-hostname/api/auth
# JWT_ISSUER=<domain>
# JWT_AUDIENCE=convex
# JWT_JWKS_URL=<domain>/api/auth/jwks

# ── JWT_ISSUER must byte-match the DEPLOYED production API's BETTER_AUTH_URL. ──
# A trailing-slash / scheme / port mismatch breaks verification. Verify current
# values: `convex env list`.

# Docker Compose local defaults
# Copy this file to .env and fill in the values marked "replace-with-..."

# Azure (optional)
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# API container runtime
PORT=8000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/app_local
REDIS_URL=redis://redis:6379
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SESSION_EXPIRES_IN=604800
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
LOCAL_SERVER_URL=http://localhost:8000
DEPLOYED_SERVER_URL=https://retro-tool.net
ENABLE_CRON_JOBS=true
WEEKLY_DIGEST_SEND_HOUR=6

# OAuth providers (optional — leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Email (Resend)
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Retro Tool <noreply@yourdomain.com>

# Browser push notifications (VAPID)
# Generate: npm install -g web-push && web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace-with-your-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-your-vapid-private-key
VAPID_SUBJECT=mailto:you@yourdomain.com

# Convex local runtime
CONVEX_INSTANCE_NAME=convex-local
DISABLE_BEACON=1
# Generate: openssl rand -hex 32
CONVEX_INSTANCE_SECRET=replace-with-64-char-hex-secret
CONVEX_POSTGRES_URL=postgresql://postgres:postgres@postgres:5432
CONVEX_DO_NOT_REQUIRE_SSL=1
CONVEX_SYNC_URL=http://convex-backend:3210
# Generated from the running local Convex backend with ./generate_admin_key.sh
CONVEX_SYNC_ADMIN_KEY=replace-with-admin-key-from-generate_admin_key.sh
CONVEX_BETTER_AUTH_URL=http://localhost:8000/api/auth

# Convex CLI/browser values
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-admin-key-from-generate_admin_key.sh
CONVEX_API_PORT=3210
CONVEX_SITE_PORT=3211
CONVEX_DASHBOARD_PORT=6791

# UI container build args
UI_PORT=3000
VITE_APP_TITLE=Retro Tool
VITE_APP_ENV=development
VITE_API_URL=http://localhost:8000
VITE_CONVEX_URL=http://localhost:3210
VITE_ESTIMATES_REALTIME_BACKEND=convex
VITE_RETROS_REALTIME_BACKEND=convex
VITE_NOTIFICATIONS_REALTIME_BACKEND=convex
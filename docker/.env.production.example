# =============================================================================
# INFRASTRUCTURE — consumed by Docker Compose to spin up services
# =============================================================================

# ── Ports ─────────────────────────────────────────────────────────────────────
POSTGRES_PORT=5432
CONVEX_API_PORT=3210
CONVEX_SITE_PORT=3211
CONVEX_DASHBOARD_PORT=6791
UI_PORT=3000

# ── Postgres container ────────────────────────────────────────────────────────
POSTGRES_USER=app-user
# Generate: openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=retro_tool_db

# ── Convex container ──────────────────────────────────────────────────────────
CONVEX_INSTANCE_NAME=convex-production
# Generate: openssl rand -hex 32
CONVEX_INSTANCE_SECRET=replace-with-64-char-hex-secret
CONVEX_POSTGRES_URL=postgresql://app-user:replace-with-password@postgres.yourdomain.com:5432?sslmode=require
CONVEX_DO_NOT_REQUIRE_SSL=0

# =============================================================================
# APP SECRETS — injected into API / UI containers at runtime
# =============================================================================

# ── API: server ───────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production

# ── API: database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://app-user:replace-with-password@postgres.yourdomain.com:5432/retro_tool_db?sslmode=require

# ── API: auth ─────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-strong-random-secret
BETTER_AUTH_URL=https://api.yourdomain.com
# Session lifetime in seconds: 1800 = 30 minutes
BETTER_AUTH_SESSION_EXPIRES_IN=1800
# Minimum renewal interval in seconds: 300 = 5 minutes
BETTER_AUTH_SESSION_UPDATE_AGE=300

# ── API: URLs & CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=https://app.yourdomain.com
LOCAL_SERVER_URL=https://api.yourdomain.com
DEPLOYED_SERVER_URL=https://api.yourdomain.com
ALLOWED_ORIGINS=https://app.yourdomain.com,https://api.yourdomain.com

# ── API: scheduled jobs ───────────────────────────────────────────────────────
ENABLE_CRON_JOBS=true
WEEKLY_DIGEST_SEND_HOUR=6

# ── API: OAuth providers (optional — leave empty to disable) ──────────────────
MICROSOFT_CLIENT_ID=replace-with-microsoft-client-id
MICROSOFT_CLIENT_SECRET=replace-with-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# ── API: email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=replace-with-resend-api-key
EMAIL_FROM=Retro Tool <noreply@yourdomain.com>

# ── API: push notifications (VAPID) ──────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=replace-with-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-vapid-private-key
VAPID_SUBJECT=mailto:noreply@yourdomain.com

# ── API: Convex sync ──────────────────────────────────────────────────────────
CONVEX_SYNC_URL=https://convex-api.yourdomain.com
# Generated from the running Convex backend: ./generate_admin_key.sh
CONVEX_SYNC_ADMIN_KEY=replace-with-production-admin-key
CONVEX_BETTER_AUTH_URL=https://api.yourdomain.com/api/auth

# ── Convex CLI / browser ──────────────────────────────────────────────────────
CONVEX_SELF_HOSTED_URL=https://convex-api.yourdomain.com
CONVEX_SELF_HOSTED_ADMIN_KEY=replace-with-production-admin-key

# ── UI container ──────────────────────────────────────────────────────────────
VITE_APP_TITLE=Retro Tool
VITE_APP_ENV=production
VITE_API_URL=https://api.yourdomain.com
VITE_AUTH_IDLE_TIMEOUT_MINUTES=30
VITE_AUTH_IDLE_WARNING_MINUTES=2
VITE_CONVEX_URL=https://convex-api.yourdomain.com
VITE_ESTIMATES_REALTIME_BACKEND=convex
VITE_RETROS_REALTIME_BACKEND=convex
VITE_ICEBREAKERS_REALTIME_BACKEND=convex
VITE_STANDUPS_REALTIME_BACKEND=convex
VITE_NOTIFICATIONS_REALTIME_BACKEND=convex

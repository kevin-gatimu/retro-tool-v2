    "lint-staged": "^16.3.2",
    "prettier": "^3.8.1",
    "typescript": "^6.0.2",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.5"
  }

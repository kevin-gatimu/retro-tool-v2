# ── App ───────────────────────────────────────────────────────────────────────
VITE_APP_TITLE=Retro Tool
VITE_APP_ENV=production

# ── API ───────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Session Security ───────────────────────────────────────────────────────────
# Log out after 30 minutes without trusted browser activity
VITE_AUTH_IDLE_TIMEOUT_MINUTES=30
# Show the inactivity warning 2 minutes before logout
VITE_AUTH_IDLE_WARNING_MINUTES=2

# ── Convex ────────────────────────────────────────────────────────────────────
VITE_CONVEX_URL=https://retrotool-prod-convex.azurewebsites.net

# ── Realtime Backends ─────────────────────────────────────────────────────────
VITE_ESTIMATES_REALTIME_BACKEND=convex
VITE_RETROS_REALTIME_BACKEND=convex
VITE_ICEBREAKERS_REALTIME_BACKEND=convex
VITE_STANDUPS_REALTIME_BACKEND=convex
VITE_NOTIFICATIONS_REALTIME_BACKEND=convex

PORT=8000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app_local

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SESSION_EXPIRES_IN=604800

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Email
RESEND_API_KEY=
EMAIL_FROM=Retro Tool <noreply@example.com>

# Frontend and CORS
FRONTEND_URL=http://localhost:3000
DEPLOYED_SERVER_URL=https://retro-tool.net
LOCAL_SERVER_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Runtime
NODE_ENV=development
REDIS_URL=redis://localhost:6379

# Browser push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@example.com

# Convex projection sync
CONVEX_SYNC_URL=http://localhost:3210
CONVEX_SYNC_ADMIN_KEY=convex-local|018fbc2493bff8150bdb28a04ba9a08c5ad6cfde249c117d41a6ab4ce3ae98560a1b70c45c

# Optional jobs
ENABLE_CRON_JOBS=true
WEEKLY_DIGEST_SEND_HOUR=6
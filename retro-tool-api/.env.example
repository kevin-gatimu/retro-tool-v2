PORT=8000

DATABASE_URL=postgresql://postgres:password@localhost:5432/retro_tool

# BETTER AUTH SETUP
BETTER_AUTH_SECRET=your-secret-key-here-change-in-development
BETTER_AUTH_SESSION_EXPIRES_IN=604800 # 7 days in seconds

# GOOGLE OAUTH (optional)
# Register your app at https://console.cloud.google.com → APIs & Services → Credentials
# Set redirect URI to: http://localhost:8000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MICROSOFT OAUTH / AZURE ENTRA ID (optional)
# Register your app at https://portal.azure.com → App registrations
# Set redirect URI to: http://localhost:8000/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Use 'common' to allow any Microsoft account, or a specific tenant ID
MICROSOFT_TENANT_ID=common

# EMAIL (Resend — https://resend.com)
# Without this, reset password links are printed to the server console instead.
RESEND_API_KEY=re_your_api_key_here
# Must be a verified sender in your Resend account
EMAIL_FROM=Retro Tool <noreply@yourdomain.com>

FRONTEND_URL=

// Server URLs for Swagger
Deployed_Server_URL=https://retro-tool.net
Local_Server_URL=http://localhost:8000

# Comma-separated list of allowed origins for CORS and auth trustedOrigins
# Include your frontend URL and API URL (for Swagger UI)
# Example: ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000,https://retro-tool.azurewebsites.net
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

NODE_ENV=production

# Redis — optional, enables caching. Without it, all queries hit the database directly.
REDIS_URL=redis://localhost:6379

# Convex projection sync — optional. Set both values to publish estimate session
# projection updates from NestJS into the self-hosted Convex backend.
CONVEX_SYNC_URL=
CONVEX_SYNC_ADMIN_KEY=
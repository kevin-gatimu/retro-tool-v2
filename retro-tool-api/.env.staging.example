# Copy to .env.staging.local and replace every required placeholder.
PORT=8000
NODE_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@retrotool-staging-db.postgres.database.azure.com:5432/retro_tool_db?sslmode=require

BETTER_AUTH_SECRET=replace-with-staging-better-auth-secret
BETTER_AUTH_URL=http://localhost:8000
BETTER_AUTH_SESSION_EXPIRES_IN=604800
BETTER_AUTH_JWT_ISSUER=https://retrotool-staging-api.azurewebsites.net
BETTER_AUTH_JWT_AUDIENCE=convex

FRONTEND_URL=http://localhost:3000
LOCAL_SERVER_URL=http://localhost:8000
DEPLOYED_SERVER_URL=https://retrotool-staging-api.azurewebsites.net
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_AUTHORITY=https://login.microsoftonline.com

RESEND_API_KEY=
EMAIL_FROM=Retro Tool <info@retro-tool.com>
EMAIL_SANDBOX_TO=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

CONVEX_SYNC_URL=https://retrotool-staging-convex.azurewebsites.net
CONVEX_SYNC_ADMIN_KEY=replace-with-staging-convex-admin-key

ENABLE_CRON_JOBS=false

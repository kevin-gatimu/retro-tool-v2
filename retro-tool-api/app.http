@cardId = <paste-card-id-here>

# Set after creating a comment
# @commentId = <paste-comment-id-here>
@commentId = <paste-comment-id-here>

# Set after creating an estimate session
# @estimateSessionId = <paste-session-id-here>
@estimateSessionId = <paste-session-id-here>

# Set after getting a notification

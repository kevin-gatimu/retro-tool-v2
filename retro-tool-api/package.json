{
  "name": "retro-tool-api",
  "version": "1.1.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "dev": "nest start --watch",
    "dev:staging": "dotenv -e .env.staging.local -- nest start --watch",
    "dev:prod": "dotenv -e .env.production.local -- nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "check": "prettier --write . && eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:generate:staging": "dotenv -e .env.staging.local -- drizzle-kit generate",
    "db:generate:prod": "dotenv -e .env.production.local -- drizzle-kit generate",
    "db:ensure:convex": "node scripts/db.mjs ensure-convex",
    "db:ensure:convex:prod": "node scripts/db.mjs ensure-convex prod",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:migrate:staging": "node scripts/db.mjs migrate staging",
    "db:migrate:prod": "node scripts/db.mjs migrate prod",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node scripts/db.mjs seed",
    "db:seed:templates": "node scripts/db.mjs seed:templates",
    "db:seed:templates:staging": "node scripts/db.mjs seed:templates staging",
    "db:seed:templates:prod": "node scripts/db.mjs seed:templates prod",
    "db:seed:icebreaker-templates": "node scripts/db.mjs seed:icebreaker-templates",
    "db:seed:icebreaker-templates:staging": "node scripts/db.mjs seed:icebreaker-templates staging",
    "db:seed:icebreaker-templates:prod": "node scripts/db.mjs seed:icebreaker-templates prod",
    "db:seed:roles": "node scripts/db.mjs seed:roles",
    "db:seed:users": "node scripts/db.mjs seed:users",
    "db:seed:large-org": "node scripts/db.mjs seed:large-org",
    "db:seed:load": "node scripts/db.mjs seed:load",
    "db:seed:staging": "node scripts/db.mjs seed:prod-safe staging",
    "db:seed:prod": "node scripts/db.mjs seed:prod-safe prod"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.6.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@thallesp/nestjs-better-auth": "^2.4.0",
    "better-auth": "^1.4.18",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "helmet": "^8.2.0",
    "load-esm": "^1.0.0",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.9.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.8.1",
    "uid": "^2.0.2",
    "undici": "^7.24.7",
    "web-push": "^3.6.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "lint-staged": "^16.3.3",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.20.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "test/**/*.ts": [
      "prettier --write"
    ]
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1",
      "^@thallesp/nestjs-better-auth$": "<rootDir>/__mocks__/@thallesp/nestjs-better-auth.ts"
    }
  }
}
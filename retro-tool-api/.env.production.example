PORT=8000

DATABASE_URL=postgresql://postgres:password@localhost:5432/retro_tool

BETTER_AUTH_SECRET=your-secret-key-here-change-in-production
BETTER_AUTH_URL=https://retrotool.com
BETTER_AUTH_SESSION_EXPIRES_IN=604800 # 7 days in seconds

# GOOGLE OAUTH (optional)
# Register your app at https://console.cloud.google.com → APIs & Services → Credentials
# Set redirect URI to: https://yourdomain.com/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MICROSOFT OAUTH / AZURE ENTRA ID (optional)
# Set redirect URI to: https://yourdomain.com/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# EMAIL (Resend — https://resend.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=Retro Tool <noreply@yourdomain.com>

FRONTEND_URL=

NODE_ENV=production

# Redis (optional — enables caching layer for performance)
# Use Azure Cache for Redis or any managed Redis provider
REDIS_URL=rediss://:<access-key>@<hostname>.redis.cache.windows.net:6380

# Convex projection sync — optional. Set both values to publish estimate session
# projection updates from NestJS into the self-hosted Convex backend.
CONVEX_SYNC_URL=
CONVEX_SYNC_ADMIN_KEY=